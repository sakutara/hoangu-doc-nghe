#!/bin/sh
# Sau khi merge vào main: luôn build prod vào docs/ và commit để GitHub Pages phục vụ docs/index.html.
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0
npm run build || exit 1
git add -A docs
git diff --cached --quiet -- docs || git commit -m "Build prod: cập nhật docs/ sau merge" -- docs
